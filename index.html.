/* ============ FRETE ============ */
function calcularFreteValores(cep, pesoTotal) {
  const limpo = cep.replace(/\D/g, ''); if (limpo.length !== 8) return null;
  const regiao = parseInt(limpo[0]);
  const fatores = { 0:1.0, 1:1.0, 2:1.3, 3:1.4, 4:1.8, 5:2.0, 6:2.3, 7:1.6, 8:1.3, 9:1.4 };
  const fator = fatores[regiao] || 1.5;
  const pac = 14.90 + (fator * 6) + (pesoTotal * 1.2);
  const sedex = 24.90 + (fator * 12) + (pesoTotal * 2.5);
  return { pac: { valor: pac, prazo: Math.round(5 + fator * 2) + ' dias úteis' }, sedex: { valor: sedex, prazo: Math.round(1 + fator) + ' dias úteis' } };
}

function calcularFreteCarrinho() {
  if (carrinho.length === 0) return;
  const cep = document.getElementById('cep-input').value;
  if (cep.replace(/\D/g,'').length !== 8) { showToast('CEP inválido.', 'error'); return; }
  const pesoTotal = carrinho.reduce((acc, i) => acc + ((i.peso || 2) * i.qtd), 0);
  const subtotal = carrinho.reduce((acc, i) => acc + (i.precoNum * i.qtd), 0);
  const valores = calcularFreteValores(cep, pesoTotal); if (!valores) return;

  cepAtual = cep; localStorage.setItem('magalu_cep', cep);
  const freteGratis = subtotal >= 299;

  document.getElementById('frete-opcoes').innerHTML = `
    <div class="frete-opt" onclick="selecionarFrete('pac', ${valores.pac.valor}, '${valores.pac.prazo}', this)">
      <div><span class="nome">PAC</span><span class="prazo">${valores.pac.prazo}</span></div>
      <span class="valor ${freteGratis ? 'gratis' : ''}">${freteGratis ? 'Grátis' : formatBRL(valores.pac.valor)}</span>
    </div>
    <div class="frete-opt" onclick="selecionarFrete('sedex', ${valores.sedex.valor}, '${valores.sedex.prazo}', this)">
      <div><span class="nome">SEDEX</span><span class="prazo">${valores.sedex.prazo}</span></div>
      <span class="valor">${formatBRL(valores.sedex.valor)}</span>
    </div>
    <div class="frete-opt" onclick="selecionarFrete('retirada', 0, 'Retirar na loja', this)">
      <div><span class="nome">Retirar na loja</span><span class="prazo">Grátis · Pronto em 2h</span></div>
      <span class="valor gratis">Grátis</span>
    </div>
  `;
  if (freteGratis) { freteSelecionado = { tipo:'pac', valor:0, prazo: valores.pac.prazo }; document.querySelectorAll('#frete-opcoes .frete-opt')[0].classList.add('selected'); }
  atualizarTotais();
}

function selecionarFrete(tipo, valor, prazo, el) {
  const subtotal = carrinho.reduce((acc, i) => acc + (i.precoNum * i.qtd), 0);
  const freteGratis = subtotal >= 299;
  freteSelecionado = { tipo, valor: (tipo === 'pac' && freteGratis) ? 0 : valor, prazo };
  document.querySelectorAll('#frete-opcoes .frete-opt').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected'); atualizarTotais();
}

function calcularFreteDetail() {
  if (!produtoAtual) return;
  const cep = document.getElementById('cep-detail').value;
  if (cep.replace(/\D/g,'').length !== 8) { showToast('CEP inválido.', 'error'); return; }
  const valores = calcularFreteValores(cep, (produtoAtual.peso || 2) * qtdProdutoModal); if (!valores) return;
  cepAtual = cep; localStorage.setItem('magalu_cep', cep);
  document.getElementById('frete-detail-opcoes').innerHTML = `
    <div class="frete-opt" onclick="this.parentElement.querySelectorAll('.frete-opt').forEach(o=>o.classList.remove('selected')); this.classList.add('selected');">
      <div><span class="nome">PAC</span><span class="prazo">${valores.pac.prazo}</span></div><span class="valor">${formatBRL(valores.pac.valor)}</span>
    </div>
    <div class="frete-opt" onclick="this.parentElement.querySelectorAll('.frete-opt').forEach(o=>o.classList.remove('selected')); this.classList.add('selected');">
      <div><span class="nome">SEDEX</span><span class="prazo">${valores.sedex.prazo}</span></div><span class="valor">${formatBRL(valores.sedex.valor)}</span>
    </div>
  `;
}

/* ============ CHECKOUT ============ */
function abrirCheckout() {
  if (carrinho.length === 0) { showToast('Sua sacola está vazia!', 'error'); return; }
  document.getElementById('cart-sidebar').classList.remove('open'); document.getElementById('cart-overlay').classList.remove('open');
  document.getElementById('checkout-modal').classList.add('open');
  document.getElementById('checkout-content').style.display = 'grid'; document.getElementById('success-screen').style.display = 'none';
  document.body.style.overflow = 'hidden'; renderizarResumoCheckout();
  if (cepAtual && !document.getElementById('pay-cep').value) { document.getElementById('pay-cep').value = cepAtual; onCepCheckoutChange(); }
}

function fecharCheckout() { document.getElementById('checkout-modal').classList.remove('open'); document.body.style.overflow = ''; }

function renderizarResumoCheckout() {
  const subtotal = carrinho.reduce((acc, i) => acc + (i.precoNum * i.qtd), 0);
  const frete = freteSelecionado ? freteSelecionado.valor : 0;
  let descontoCupom = 0;
  if (cupomAplicado) {
    const c = cuponsValidos[cupomAplicado];
    descontoCupom = c.tipo === 'percent' ? subtotal * (c.valor / 100) : c.valor;
  }
  
  const totalBase = subtotal - descontoCupom + frete;
  const parcSel = document.getElementById('pay-parcelas');
  if (parcSel && parcSel.options.length === 0) {
    for (let i = 1; i <= 10; i++) { const opt = document.createElement('option'); opt.value = i; opt.textContent = `${i}x de ${formatBRL(totalBase/i)} sem juros`; parcSel.appendChild(opt); }
  }
  const parcelas = parseInt(parcSel ? parcSel.value : 1) || 1;

  let totalFinal = totalBase;
  let notaTotal = '';
  if (formaPagamento === 'pix') { 
    const descontoPix = calcDescontoPixCarrinho(); totalFinal = totalBase - descontoPix; 
    notaTotal = descontoPix > 0 ? `Economize ${formatBRL(descontoPix)} pagando no Pix` : ''; 
  }
  else if (formaPagamento === 'cartao') { 
    notaTotal = `${parcelas}x de ${formatBRL(totalBase/parcelas)} sem juros`; 
  }

  document.getElementById('checkout-resumo').innerHTML = carrinho.map(item => `<div class="resumo-item"><span>${item.qtd}x ${item.title.length > 30 ? item.title.substring(0, 30) + '…' : item.title}</span><span>${formatBRL(item.precoNum * item.qtd)}</span></div>`).join('') + `
    <div class="resumo-divider"></div>
    <div class="resumo-item"><span>Subtotal</span><strong>${formatBRL(subtotal)}</strong></div>
    ${descontoCupom > 0 ? `<div class="resumo-item" style="color:var(--green);"><span>Cupom (${cupomAplicado})</span><span>- ${formatBRL(descontoCupom)}</span></div>` : ''}
    <div class="resumo-item"><span>Frete</span><strong>${frete === 0 ? 'Grátis' : formatBRL(frete)}</strong></div>
    ${formaPagamento === 'pix' ? `<div class="resumo-item" style="color:var(--green);"><span>Desconto Pix</span><span>- ${formatBRL(calcDescontoPixCarrinho())}</span></div>` : ''}
  `;

  document.getElementById('checkout-total').textContent = formatBRL(totalFinal);
  document.getElementById('checkout-total-nota').textContent = notaTotal;
  document.getElementById('pix-opt-desc').textContent = `Aprovação imediata com desconto no Pix`;
  
  document.getElementById('checkout-side').innerHTML = `
    <div class="checkout-box">
      <h3><i class="fa-solid fa-bag-shopping"></i> Sua sacola</h3>
      ${carrinho.map(item => `<div class="resumo-item"><span>${item.qtd}x ${item.title.length > 20 ? item.title.substring(0, 20) + '…' : item.title}</span><span>${formatBRL(item.precoNum * item.qtd)}</span></div>`).join('')}
      <div class="resumo-total"><span>Total:</span><span>${formatBRL(totalFinal)}</span></div>
    </div>
  `;
}

function selPgto(tipo, el) {
  formaPagamento = tipo; document.querySelectorAll('.pay-opt').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected'); document.getElementById('campos-cartao').style.display = tipo === 'cartao' ? 'block' : 'none';
  renderizarResumoCheckout();
}

function onCepCheckoutChange() {
  const cep = document.getElementById('pay-cep').value;
  if (cep.replace(/\D/g,'').length === 8) {
    const pesoTotal = carrinho.reduce((acc, i) => acc + ((i.peso || 2) * i.qtd), 0);
    const subtotal = carrinho.reduce((acc, i) => acc + (i.precoNum * i.qtd), 0);
    const freteGratis = subtotal >= 299;
    const valores = calcularFreteValores(cep, pesoTotal);
    if (valores) {
      document.getElementById('checkout-frete-opcoes').innerHTML = `
        <div class="frete-opt" onclick="document.querySelectorAll('#checkout-frete-opcoes .frete-opt').forEach(o=>o.classList.remove('selected')); this.classList.add('selected'); freteSelecionado={tipo:'pac',valor:${freteGratis ? 0 : valores.pac.valor},prazo:'${valores.pac.prazo}'}; renderizarResumoCheckout();">
          <div><span class="nome">PAC</span><span class="prazo">${valores.pac.prazo}</span></div><span class="valor ${freteGratis ? 'gratis' : ''}">${freteGratis ? 'Grátis' : formatBRL(valores.pac.valor)}</span>
        </div>
        <div class="frete-opt" onclick="document.querySelectorAll('#checkout-frete-opcoes .frete-opt').forEach(o=>o.classList.remove('selected')); this.classList.add('selected'); freteSelecionado={tipo:'sedex',valor:${valores.sedex.valor},prazo:'${valores.sedex.prazo}'}; renderizarResumoCheckout();">
          <div><span class="nome">SEDEX</span><span class="prazo">${valores.sedex.prazo}</span></div><span class="valor">${formatBRL(valores.sedex.valor)}</span>
        </div>
      `;
