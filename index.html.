/* ============ UTILS ============ */
function parseBRL(str) { return parseFloat(str.replace(/\./g, '').replace(',', '.')); }
function formatBRL(v) { return v.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}); }
function calcPrecoPix(prod) { return parseBRL(prod.price) * (1 - (prod.pix || 0) / 100); }
function calcDescontoPixCarrinho() { return carrinho.reduce((acc, i) => acc + (i.precoNum * (i.pix || 0) / 100 * i.qtd), 0); }

function showToast(msg, type='success') {
  const el = document.createElement('div');
  el.className = 'toast ' + (type === 'error' ? 'error' : '');
  el.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check'}"></i> <span>${msg}</span>`;
  document.getElementById('toast-container').appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 300); }, 3200);
}

function mascaraCEP(input) { let v = input.value.replace(/\D/g, '').slice(0, 8); if (v.length > 5) v = v.replace(/(\d{5})(\d)/, '$1-$2'); input.value = v; }
function mascaraCPF(input) { let v = input.value.replace(/\D/g, '').slice(0, 11); v = v.replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d{1,2})$/, '$1-$2'); input.value = v; }
function mascaraCartao(input) { let v = input.value.replace(/\D/g, '').slice(0, 16); v = v.replace(/(\d{4})(?=\d)/g, '$1 '); input.value = v; }
function mascaraValidade(input) { let v = input.value.replace(/\D/g, '').slice(0, 4); if (v.length >= 3) v = v.replace(/(\d{2})(\d)/, '$1/$2'); input.value = v; }
function mascaraTelefone(input) { let v = input.value.replace(/\D/g, '').slice(0, 11); if (v.length > 10) v = v.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3'); else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4})(\d{0,4}).*/, '($1) $2-$3'); else if (v.length > 2) v = v.replace(/^(\d{2})(\d{0,5})/, '($1) $2'); else if (v.length > 0) v = v.replace(/^(\d*)/, '($1'); input.value = v; }
function validarCPF(cpf) {
  cpf = cpf.replace(/\D/g, '');
  if (cpf.length !== 11 || /^(\d)\1+$/.test(cpf)) return false;
  let s = 0; for (let i = 0; i < 9; i++) s += parseInt(cpf[i]) * (10 - i);
  let d1 = (s * 10) % 11; if (d1 === 10) d1 = 0; if (d1 !== parseInt(cpf[9])) return false;
  s = 0; for (let i = 0; i < 10; i++) s += parseInt(cpf[i]) * (11 - i);
  let d2 = (s * 10) % 11; if (d2 === 10) d2 = 0; return d2 === parseInt(cpf[10]);
}

/* ============ PERSISTÊNCIA ============ */
function salvarCarrinho() { localStorage.setItem('magalu_carrinho', JSON.stringify(carrinho.map(i => ({ id: i.id, qtd: i.qtd })))); }
function carregarCarrinho() {
  try {
    const saved = JSON.parse(localStorage.getItem('magalu_carrinho') || '[]');
    carrinho = saved.map(s => {
      const prod = produtos.find(p => p.id === s.id);
      if (!prod) return null;
      return { ...prod, precoNum: parseBRL(prod.price), qtd: s.qtd };
    }).filter(Boolean);
  } catch { carrinho = []; }
}

/* ============ FAVORITOS ============ */
function toggleFavorito(id, event) {
  if (event) event.stopPropagation();
  const idx = favoritos.indexOf(id);
  if (idx === -1) { favoritos.push(id); showToast("Adicionado aos favoritos!"); }
  else { favoritos.splice(idx, 1); showToast("Removido dos favoritos."); }
  localStorage.setItem('magalu_favs', JSON.stringify(favoritos));
  renderVitrine();
  atualizarBadges();
}

function abrirFavoritos() {
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  const chipFav = document.querySelector('.chip[data-chip="favoritos"]');
  if(chipFav) chipFav.classList.add('active');
  filtroChip = 'favoritos';
  filtroCategoria = 'todas';
  document.querySelectorAll('.nav-categorias a').forEach(a => a.classList.remove('active'));
  document.getElementById('section-title').textContent = 'Meus Favoritos';
  renderVitrine();
}

function atualizarBadges() {
  const favBadge = document.getElementById('fav-badge');
  if (favoritos.length > 0) { favBadge.textContent = favoritos.length; favBadge.style.display = 'block'; }
  else favBadge.style.display = 'none';
}

/* ============ FILTROS E RENDER ============ */
function aplicarFiltros() {
  filtroBusca = document.getElementById('busca').value.trim();
  document.getElementById('btn-clear').classList.toggle('show', filtroBusca.length > 0);
  renderVitrine();
}
function limparBusca() {
  document.getElementById('busca').value = ''; filtroBusca = '';
  document.getElementById('btn-clear').classList.remove('show'); renderVitrine();
}
function filtrarCategoria(cat, el) {
  filtroCategoria = cat; filtroChip = null;
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  document.querySelectorAll('.nav-categorias a').forEach(a => a.classList.remove('active'));
  if(el) el.classList.add('active');
  document.getElementById('section-title').textContent = cat === 'todas' ? 'Para descobrir e aproveitar' : (cat === 'ofertas' ? 'Ofertas do Dia' : el.textContent);
  renderVitrine();
}
function resetarFiltros() {
  filtroCategoria = 'todas'; filtroBusca = ''; filtroChip = null; ordenacaoAtual = 'relevancia';
  document.getElementById('busca').value = '';
  document.getElementById('ordenacao').value = 'relevancia';
  document.querySelectorAll('.nav-categorias a').forEach(a => a.classList.toggle('active', a.dataset.cat === 'todas'));
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  document.getElementById('section-title').textContent = 'Para descobrir e aproveitar';
  renderVitrine();
}
function toggleChip(tipo, el) {
  if (filtroChip === tipo) { filtroChip = null; el.classList.remove('active'); }
  else { filtroChip = tipo; document.querySelectorAll('.chip').forEach(c => c.classList.remove('active')); el.classList.add('active'); }
  renderVitrine();
}
function ordenar(val) { ordenacaoAtual = val; renderVitrine(); }

function renderVitrine() {
  const grid = document.getElementById('grid-produtos');
  let lista = [...produtos];

  if (filtroCategoria !== 'todas') {
    if (filtroCategoria === 'ofertas') lista = lista.filter(p => parseBRL(p.old) > parseBRL(p.price));
    else lista = lista.filter(p => p.categoria === filtroCategoria);
  }
  if (filtroBusca) lista = lista.filter(p => p.title.toLowerCase().includes(filtroBusca.toLowerCase()));

  if (filtroChip) {
    if (filtroChip === 'ofertas') lista = lista.filter(p => parseBRL(p.old) > parseBRL(p.price));
    if (filtroChip === 'full') lista = lista.filter(p => p.badges?.includes('full'));
    if (filtroChip === 'top') lista = lista.filter(p => parseFloat(p.rating) >= 4.8);
    if (filtroChip === 'barato') lista = lista.filter(p => parseBRL(p.price) <= 500);
    if (filtroChip === 'favoritos') lista = lista.filter(p => favoritos.includes(p.id));
  }

  if (ordenacaoAtual === 'menor') lista.sort((a,b) => parseBRL(a.price) - parseBRL(b.price));
  if (ordenacaoAtual === 'maior') lista.sort((a,b) => parseBRL(b.price) - parseBRL(a.price));
  if (ordenacaoAtual === 'avaliacao') lista.sort((a,b) => parseFloat(b.rating || 0) - parseFloat(a.rating || 0));
  if (ordenacaoAtual === 'desconto') lista.sort((a,b) => (parseBRL(b.old) - parseBRL(b.price)) - (parseBRL(a.old) - parseBRL(a.price)));

  document.getElementById('results-count').textContent = `${lista.length} produto(s) encontrado(s)`;

  if (lista.length === 0) {
    grid.innerHTML = `<div class="sem-resultado"><i class="fa-solid fa-magnifying-glass"></i><p>Nenhum produto encontrado com esses filtros.</p><button onclick="resetarFiltros()">Limpar busca</button></div>`;
    return;
  }

  grid.innerHTML = lista.map(p => {
    const badgesArr = p.badges || [];
    let badgesHTML = '';
    if (badgesArr.includes('full')) badgesHTML += `<div class="badge-full"><i class="fa-solid fa-truck-fast"></i> Full</div>`;
    if (badgesArr.includes('montagem')) badgesHTML += `<div class="badge-montagem">COMPRE<br>MONTAGEM</div>`;
    if (badgesArr.includes('imperdivel')) badgesHTML += `<div class="badge-oferta">IMPERDÍVEL</div>`;
    if (badgesArr.includes('oferta')) badgesHTML += `<div class="badge-full" style="background:#111; font-size:12px;">OFERTA</div>`;
    
    const oldBRL = parseBRL(p.old); const preco = parseBRL(p.price);
    if (oldBRL > preco) badgesHTML += `<div class="badge-off">${Math.round((1 - preco/oldBRL)*100)}% OFF</div>`;

    let ratingHTML = '';
    if (p.rating) {
      let stars = ''; const nota = parseFloat(p.rating);
      for (let i = 1; i <= 5; i++) {
        if (nota >= i) stars += '<i class="fa-solid fa-star"></i>';
        else if (nota >= i - 0.5) stars += '<i class="fa-solid fa-star-half-stroke"></i>';
        else stars += '<i class="fa-regular fa-star"></i>';
      }
      ratingHTML = `<div class="rating"><span>${p.rating}</span> <div class="stars">${stars}</div> <span class="reviews">(${p.reviews})</span></div>`;
    }

    const precoPix = calcPrecoPix(p); const mostrarPix = p.pix > 0;
    const isFav = favoritos.includes(p.id);

    return `
      <div class="card" tabindex="0" role="button" aria-label="${p.title}" onclick="abrirProduto(${p.id})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();abrirProduto(${p.id})}">
        <button class="btn-fav ${isFav?'active':''}" onclick="toggleFavorito(${p.id}, event)" aria-label="Favoritar"><i class="fa-${isFav?'solid':'regular'} fa-heart"></i></button>
        <div class="badges">${badgesHTML}</div>
        <div class="img-container"><img src="${p.img}" loading="lazy" onerror="this.src='${fallbackImg}'" alt="${p.title}"></div>
        <h3>${p.title}</h3>
        ${ratingHTML}
        <div class="price-box">
          <span class="price"><small>R$</small> ${formatBRL(mostrarPix ? precoPix : preco).replace('R$','').trim()}</span>
          ${mostrarPix ? '<span class="pix-text">no Pix</span>' : ''}
        </div>
        <div class="installments">ou ${formatBRL(preco)} em ${p.inst}</div>
        <div class="card-actions">
          <button class="btn-add" onclick="event.stopPropagation(); adicionarCarrinho(${p.id}, 1, event)"><i class="fa-solid fa-cart-plus"></i> Adicionar</button>
        </div>
      </div>
    `;
  }).join('');
}

/* ============ CARRINHO ============ */
function adicionarCarrinho(id, qtd, event) {
  const prod = produtos.find(p => p.id === id); if (!prod) return;
  const item = carrinho.find(i => i.id === id);
  if (item) item.qtd += qtd; else carrinho.push({ ...prod, precoNum: parseBRL(prod.price), qtd });
  salvarCarrinho(); atualizarCarrinho();
  if (event && event.target) {
    const btn = event.target.closest('button');
    if (btn) {
      const orig = btn.innerHTML;
      btn.innerHTML = 'Adicionado!'; btn.classList.add('added');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('added'); }, 1200);
    }
  }
  showToast("Produto adicionado à sacola!");
}

function alterarQtd(id, delta) {
  const idx = carrinho.findIndex(i => i.id === id); if (idx === -1) return;
  carrinho[idx].qtd += delta;
  if (carrinho[idx].qtd <= 0) carrinho.splice(idx, 1);
  salvarCarrinho(); atualizarCarrinho();
}

function removerItem(id) { carrinho = carrinho.filter(i => i.id !== id); salvarCarrinho(); atualizarCarrinho(); showToast('Item removido.'); }

function aplicarCupom() {
  const val = document.getElementById('cupom-input').value.trim().toUpperCase();
  if (cuponsValidos[val]) {
    cupomAplicado = val;
    document.getElementById('coupon-form').style.display = 'none';
    document.getElementById('coupon-tag').style.display = 'flex';
    document.getElementById('coupon-label').innerHTML = `<i class="fa-solid fa-tag"></i> Cupom <strong>${val}</strong> aplicado!`;
    showToast('Cupom aplicado com sucesso!'); atualizarCarrinho();
  } else { showToast('Cupom inválido ou expirado.', 'error'); }
}
function removerCupom() {
  cupomAplicado = null;
  document.getElementById('coupon-form').style.display = 'flex';
  document.getElementById('coupon-tag').style.display = 'none';
  document.getElementById('cupom-input').value = '';
  atualizarCarrinho(); showToast('Cupom removido.');
}

function atualizarCarrinho() {
  const list = document.getElementById('cart-items');
  const badge = document.getElementById('cart-badge');
  const shippingBox = document.getElementById('shipping-box');
  const freeShipBox = document.getElementById('free-ship');

  if (carrinho.length === 0) {
    list.innerHTML = '<div class="cart-empty"><i class="fa-solid fa-bag-shopping"></i><p>Sua sacola está vazia.</p></div>';
    badge.style.display = 'none'; shippingBox.style.display = 'none'; freeShipBox.style.display = 'none';
    freteSelecionado = null;
    document.getElementById('coupon-box').style.display = 'none';
  } else {
    list.innerHTML = carrinho.map(item => `
      <div class="cart-item">
        <img src="${item.img}" onerror="this.src='${fallbackImg}'">
        <div class="cart-item-info">
          <h4>${item.title.substring(0, 40)}${item.title.length > 40 ? '…' : ''}</h4>
          <div class="cart-item-price">${formatBRL(item.precoNum)}</div>
          <div class="cart-item-row">
            <div class="qty-controls">
              <button onclick="alterarQtd(${item.id}, -1)">-</button>
              <span>${item.qtd}</span>
              <button onclick="alterarQtd(${item.id}, 1)">+</button>
            </div>
            <button class="btn-remove" onclick="removerItem(${item.id})">Remover</button>
          </div>
        </div>
      </div>
    `).join('');
    badge.textContent = carrinho.reduce((a,i) => a + i.qtd, 0);
    badge.style.display = 'block'; shippingBox.style.display = 'block'; freeShipBox.style.display = 'block';
    document.getElementById('coupon-box').style.display = 'block';

    if (cepAtual && !document.getElementById('cep-input').value) {
      document.getElementById('cep-input').value = cepAtual; calcularFreteCarrinho();
    }
  }
  atualizarTotais();
}

function atualizarTotais() {
  const subtotal = carrinho.reduce((acc, i) => acc + (i.precoNum * i.qtd), 0);
  
  const metaFrete = 299;
  if (subtotal >= metaFrete) {
    document.getElementById('free-ship-text').innerHTML = '<strong>Você ganhou frete grátis!</strong>';
    document.getElementById('free-ship-bar').style.width = '100%';
  } else {
    document.getElementById('free-ship-text').innerHTML = `Faltam <strong>${formatBRL(metaFrete - subtotal)}</strong> para o frete grátis!`;
    document.getElementById('free-ship-bar').style.width = `${(subtotal / metaFrete) * 100}%`;
  }

  let descontoCupom = 0;
  if (cupomAplicado) {
    const c = cuponsValidos[cupomAplicado];
    descontoCupom = c.tipo === 'percent' ? subtotal * (c.valor / 100) : c.valor;
    document.getElementById('cart-cupom-row').style.display = 'flex';
    document.getElementById('cart-cupom-label').textContent = `Cupom (${cupomAplicado})`;
    document.getElementById('cart-cupom-valor').textContent = `- ${formatBRL(descontoCupom)}`;
  } else {
    document.getElementById('cart-cupom-row').style.display = 'none';
  }

  const frete = freteSelecionado ? freteSelecionado.valor : 0;
  document.getElementById('cart-subtotal').textContent = formatBRL(subtotal);
  if (freteSelecionado) {
    document.getElementById('cart-frete-row').style.display = 'flex';
    document.getElementById('cart-frete').textContent = frete === 0 ? 'Grátis' : formatBRL(frete);
  } else {
    document.getElementById('cart-frete-row').style.display = 'none';
  }

  const totalFinal = subtotal - descontoCupom + frete;
  document.getElementById('cart-total').textContent = formatBRL(totalFinal);
  
  const descontoPix = calcDescontoPixCarrinho(); const totalPix = totalFinal - descontoPix;
  document.getElementById('cart-pix-total').textContent = `ou ${formatBRL(totalPix)} no Pix`;
  document.getElementById('cart-pix-hint').textContent = descontoPix > 0 ? `Economize ${formatBRL(descontoPix)} pagando com Pix` : '';
}

function toggleCart() {
  document.getElementById('cart-sidebar').classList.toggle('open');
  document.getElementById('cart-overlay').classList.toggle('open');
}

