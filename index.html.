      renderizarResumoCheckout();
    }
  }
}

function validarFormulario() {
  let valid = true;
  const campos = [
    { id: 'pay-nome', erro: 'erro-nome', val: v => v.length >= 3 },
    { id: 'pay-cpf', erro: 'erro-cpf', val: v => validarCPF(v) },
    { id: 'pay-email', erro: 'erro-email', val: v => v.includes('@') && v.includes('.') },
    { id: 'pay-tel', erro: 'erro-tel', val: v => v.replace(/\D/g,'').length >= 10 },
    { id: 'pay-cep', erro: 'erro-cep', val: v => v.replace(/\D/g,'').length === 8 },
    { id: 'pay-endereco', erro: 'erro-endereco', val: v => v.length >= 5 },
    { id: 'pay-bairro', erro: 'erro-bairro', val: v => v.length >= 2 },
    { id: 'pay-cidade', erro: 'erro-cidade', val: v => v.length >= 3 }
  ];
  if (formaPagamento === 'cartao') {
    campos.push({ id: 'pay-cartao', erro: 'erro-cartao', val: v => v.replace(/\D/g,'').length >= 13 });
    campos.push({ id: 'pay-validade', erro: 'erro-validade', val: v => v.length >= 5 });
    campos.push({ id: 'pay-cvv', erro: 'erro-cvv', val: v => v.length >= 3 });
    campos.push({ id: 'pay-nome-cartao', erro: 'erro-nome-cartao', val: v => v.length >= 3 });
  }

  campos.forEach(c => {
    const input = document.getElementById(c.id);
    const erroMsg = document.getElementById(c.erro);
    if (!c.val(input.value.trim())) { input.classList.add('erro'); if(erroMsg) erroMsg.classList.add('show'); valid = false; }
    else { input.classList.remove('erro'); if(erroMsg) erroMsg.classList.remove('show'); }
  });

  return valid;
}

