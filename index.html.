      successHTML = `<h4>Boleto gerado</h4><p style="font-size:12px;color:#666;margin-bottom:10px;">Vencimento em 2 dias úteis.</p><div class="copy-field"><input type="text" value="34191.79001 01043.510047 91020.150008 9 98765432100000" readonly><button onclick="showToast('Linha digitável copiada!')">Copiar</button></div>`;
    } else {
      successHTML = `<h4>Pagamento aprovado no cartão</h4><p style="font-size:13px;color:var(--green);font-weight:700;"><i class="fa-solid fa-circle-check"></i> ${document.getElementById('pay-parcelas').value}x de ${formatBRL(parseBRL(totalTxt.replace('R$','').trim())/document.getElementById('pay-parcelas').value)}</p>`;
    }
    document.getElementById('success-box').innerHTML = successHTML;

    carrinho = []; freteSelecionado = null; cupomAplicado = null;
    salvarCarrinho(); atualizarCarrinho();
    document.getElementById('checkout-content').style.display = 'none';
    document.getElementById('success-screen').style.display = 'block';
    btn.textContent = 'Pagar Agora'; btn.disabled = false;
  }, 1500);
}

function voltarLoja() {
  fecharCheckout();
  document.querySelectorAll('.checkout-modal input').forEach(i => i.value = '');
  document.querySelectorAll('.checkout-modal .erro').forEach(e => e.classList.remove('erro'));
  document.querySelectorAll('.checkout-modal .msg-erro').forEach(e => e.classList.remove('show'));
  document.getElementById('campos-cartao').style.display = 'none';
  document.getElementById('frete-opcoes').innerHTML = ''; document.getElementById('cep-input').value = '';
  document.getElementById('cupom-input').value = ''; document.getElementById('coupon-form').style.display = 'flex'; document.getElementById('coupon-tag').style.display = 'none';
  formaPagamento = 'pix'; document.querySelectorAll('.pay-opt').forEach((o,i) => o.classList.toggle('selected', i === 0));
  window.scrollTo(0, 0);
}

function assinarNewsletter() {
  const email = document.getElementById('news-email').value.trim();
  if (email.includes('@') && email.includes('.')) { showToast('Inscrição realizada com sucesso!'); document.getElementById('news-email').value = ''; }
  else showToast('Informe um e-mail válido.', 'error');
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    if (document.getElementById('product-modal').classList.contains('open')) fecharProdutoModal({target:{id:'product-modal'}});
    if (document.getElementById('cart-sidebar').classList.contains('open')) toggleCart();
  }
});

/* INIT */
carregarCarrinho();
renderVitrine();
atualizarCarrinho();
atualizarBadges();
</script>
</body>
</html>
